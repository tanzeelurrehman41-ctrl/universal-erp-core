# Multi-stage Docker build for Universal ERP API (ASP.NET Core .NET 10)
# Optimized for Render Free Linux container deployment (< 512MB RAM)

FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /app

# Copy shared MSBuild configuration and project definitions for layer caching
COPY src/backend/Directory.Build.props src/backend/
COPY src/backend/src/UniversalErp.Domain/*.csproj src/backend/src/UniversalErp.Domain/
COPY src/backend/src/UniversalErp.Application/*.csproj src/backend/src/UniversalErp.Application/
COPY src/backend/src/UniversalErp.Infrastructure/*.csproj src/backend/src/UniversalErp.Infrastructure/
COPY src/backend/src/UniversalErp.Api/*.csproj src/backend/src/UniversalErp.Api/

RUN dotnet restore src/backend/src/UniversalErp.Api/UniversalErp.Api.csproj

# Copy complete source tree and publish Release build
COPY src/backend/src/ src/backend/src/
RUN dotnet publish src/backend/src/UniversalErp.Api/UniversalErp.Api.csproj -c Release -o /app/publish /p:UseAppHost=false

# Production runtime stage
FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS runtime
WORKDIR /app

# Enable low-overhead server GC optimized for container resource limits
ENV DOTNET_EnableDiagnostics=0 \
    DOTNET_GCHeapHardLimit=0x18000000 \
    ASPNETCORE_URLS=http://0.0.0.0:10000 \
    PORT=10000

COPY --from=build /app/publish .

EXPOSE 10000
ENTRYPOINT ["dotnet", "UniversalErp.Api.dll"]
