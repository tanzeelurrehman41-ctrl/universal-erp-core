<Window x:Class="UniversalErp.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Universal ERP" Height="560" Width="920"
        WindowStartupLocation="CenterScreen">
    <Grid Background="#F4F6FA">
        <Border Margin="28" Padding="32" Background="White" CornerRadius="16">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="UNIVERSAL ERP" FontSize="12" FontWeight="Bold" Foreground="#68758C"/>
                <TextBlock Text="Windows application foundation" FontSize="30" FontWeight="SemiBold" Margin="0,14,0,8"/>
                <TextBlock Text="Desktop shell created. Secure authentication, offline database and business modules are not connected yet."
                           FontSize="15" Foreground="#657188" TextWrapping="Wrap" MaxWidth="650"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
